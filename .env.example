# Discord Bot Configuration
# Get your token from: https://discord.com/developers/applications

# Discord Bot Token (required)
# 1. Go to https://discord.com/developers/applications
# 2. Select your application (or create a new one)
# 3. Go to the "Bot" section
# 4. Click "Reset Token" and copy it here
# IMPORTANT: Keep this token secret! Never share it or commit it to Git
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID (required)
# Found in the "General Information" section of your application
DISCORD_CLIENT_ID=your_client_id_here

# Bot Command Prefix (optional, default: !)
# This is the character(s) that triggers bot commands
# Examples: !, /, ?, bdo!
BOT_PREFIX=!

# Environment Name (optional, default: env)
# Used to identify the environment the bot is running in
# Values: env (development), prod (production)
ENV_NAME=env

# Browser configuration for scraper (optional)
# BROWSER_NAME: chrome | chromium | firefox
BROWSER_NAME=chrome
# BROWSER_HEADLESS: true | false
BROWSER_HEADLESS=true
# Optional: Set browser window size
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# Logging configuration (optional)
# LOG_LEVEL: error | warn | info | verbose | debug | silly
LOG_LEVEL=info

# Proxy configuration for scraping (optional)
# Base URL for the local proxy service used by all scrapers
# Default: http://localhost:9432/proxy
PROXY_URL=http://localhost:9432/proxy

# Scraper time budget (optional)
# Maximum time in milliseconds to spend on certain blocking steps (e.g., consent dismissal)
# Default: 12000
SCRAPER_TIMEOUT_MS=12000
